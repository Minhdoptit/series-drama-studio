# ─── Database ────────────────────────────
DB_PASSWORD=your-strong-db-password

# ─── JWT — BẮT BUỘC, tối thiểu 32 ký tự ──
# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ─── Encryption key cho API keys ─────────
# BẮT BUỘC. Fernet key: 32 bytes encode base64 URL-safe (44 ký tự).
# Tạo bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── CORS — origin được phép, cách nhau bằng dấu phẩy ───
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database — driver phải là psycopg (xem requirements.txt), KHÔNG phải asyncpg
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/drama_studio

# JWT Auth — BẮT BUỘC, tối thiểu 32 ký tự. App sẽ không khởi động nếu thiếu.
# Tạo: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Encryption (mã hoá API key lưu trong DB) — BẮT BUỘC, Fernet key 44 ký tự.
# App sẽ không khởi động nếu thiếu hoặc sai định dạng.
# Tạo: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# CORS — danh sách origin được phép, ngăn cách bằng dấu phẩy. Không dùng "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File storage
DATA_DIR=../data
MAX_UPLOAD_SIZE_MB=50
